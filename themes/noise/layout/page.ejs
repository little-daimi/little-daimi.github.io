<% if (page.type === 'tags' || page.type === 'categories') { const isTags = page.type === 'tags'; const items = isTags ? site.tags : site.categories; %>
<section class="taxonomy-page"><header class="page-heading"><span class="eyebrow">03 / INDEX</span><div class="page-title-row"><h1><%= isTags ? '标签索引' : '分类浏览' %><span class="title-period">.</span></h1><span class="big-asterisk" aria-hidden="true">✳</span></div><p><span class="index-notation" aria-hidden="true">[ &nbsp; ∷ / 001 — 0 &nbsp; ]</span></p></header><div class="archive-toolbar"><a href="<%- url_for('/archives/') %>">全部记录</a><a class="<%= isTags ? 'selected' : '' %>" href="<%- url_for('/tags/') %>">标签索引</a><a class="<%= !isTags ? 'selected' : '' %>" href="<%- url_for('/categories/') %>">分类浏览</a></div><div class="taxonomy-grid"><% items.sort('length', -1).each(function(item, i) { %><a class="taxonomy-item" href="<%- url_for(item.path) %>"><span class="eyebrow">INDEX / <%= String(i + 1).padStart(2, '0') %></span><h2><%= item.name %></h2><div><span><%= item.length %> 篇记录</span><span>↗</span></div></a><% }) %></div></section>
<% } else if (page.type === 'friends') { %>
<%- partial("_partial/friends") %>
<% } else if (page.path === 'about/index.html') { %>
<section class="about-page"><header class="page-heading"><span class="eyebrow">04 / IMIAB</span><h1>关于<span class="serif-italic"> / imiab</span><span class="title-period">.</span></h1></header><div class="about-grid"><div class="about-specimen" aria-hidden="true"><span class="about-echo">i m i a b /</span><span class="about-glyph">u</span><span class="about-label">00 / 0x69 6d 69 61 62</span><span class="about-cut">◯</span></div><div class="about-text prose"><%- page.content %><%- partial("_partial/awards") %><div class="about-stats"><div><b><%= site.posts.length %></b><span>篇记录</span></div><div><b><%= site.tags.length %></b><span>个标签</span></div><div><b>2025</b><span>开始记录</span></div></div></div></section>
<% } else { %><section class="simple-page"><header class="page-heading"><span class="eyebrow">FIELD NOTES</span><h1><%= page.title %><span class="title-period">.</span></h1></header><div class="prose"><%- page.content %></div></section><% } %>

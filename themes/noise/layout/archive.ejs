<section class="archive-page"><header class="page-heading"><span class="eyebrow"><%= page.tag ? '03 / TAGGED FRAGMENTS' : page.category ? '03 / BY SUBJECT' : '02 / ARCHIVE' %></span><div class="page-title-row"><h1><%= page.tag ? page.tag : page.category || '文章归档' %><span class="title-period">.</span></h1><span class="archive-count"><%= page.tag || page.category ? page.posts.length : site.posts.length %> <small><%= page.tag || page.category ? 'ON THIS PAGE' : 'ENTRIES & COUNTING' %></small></span></div><p><%= page.tag ? '与「' + page.tag + '」有关的记录。' : page.category ? '分类 / ' + page.category : '2025 — ' + new Date().getFullYear() + ' / ' + site.posts.length + ' entries' %></p></header><div class="archive-toolbar"><a class="<%= !page.tag && !page.category ? 'selected' : '' %>" href="<%- url_for('/archives/') %>">全部记录</a><a href="<%- url_for('/tags/') %>">标签索引 ↗</a><a href="<%- url_for('/categories/') %>">分类浏览 ↗</a><button data-search-open>搜索文章 ⌕</button></div><div class="archive-list"><% let archiveYear = ''; page.posts.each(function(post) { const year = date(post.date, 'YYYY'); if (year !== archiveYear) { archiveYear = year; %><div class="archive-year"><h2><%= year %></h2><span>/ 00—12</span></div><% } %><a class="archive-row" href="<%- url_for(post.path) %>"><time datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'MM.DD') %></time><h3><%= post.title %></h3><span class="archive-category"><%= post.categories.length ? post.categories.first().name : 'NOTES' %></span><span class="archive-arrow" aria-hidden="true">↗</span></a><% }) %></div><%- partial('_partial/pagination') %><% if (page.tag || page.category) { %><a class="text-link archive-back" href="<%- url_for('/archives/') %>">← 返回全部归档</a><% } %></section>

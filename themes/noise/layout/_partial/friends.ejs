<section class="friends-page">
  <header class="page-heading">
    <span class="eyebrow">05 / FRIENDS &amp; LINKS</span>
    <div class="page-title-row"><h1>友链<span class="serif-italic"> / friends</span><span class="title-period">.</span></h1><span class="friends-count"><%= String((page.friends || []).length).padStart(2, '0') %><small>SITES</small></span></div>
    <p>朋友们的博客与技术记录。</p>
  </header>
  <div class="friends-grid">
    <% (page.friends || []).forEach(function(friend, i) { %>
    <a class="friend-card" href="<%= friend.url %>" target="_blank" rel="noopener noreferrer" aria-label="访问 <%= friend.name %> 的博客（新窗口打开）">
      <div class="friend-preview"><img src="<%- url_for(friend.preview) %>" alt="" width="1200" height="750" loading="lazy"><span class="friend-number" aria-hidden="true"><%= String(i + 1).padStart(2, '0') %> / 05</span><span class="friend-open" aria-hidden="true">↗</span></div>
      <div class="friend-info"><span class="friend-mark" aria-hidden="true"><% if (friend.avatar) { %><img src="<%- url_for(friend.avatar) %>" alt="" width="48" height="48" loading="lazy" decoding="async"><% } else { %><%= friend.mark %><% } %></span><div><h2><%= friend.name %></h2><p><%= friend.description %></p></div><span class="friend-field"><%= friend.field %></span></div>
      <div class="friend-footer"><span><%= friend.url.replace(/^https?:\/\//, '').replace(/\/$/, '') %></span><span>VISIT SITE ↗</span></div>
    </a>
    <% }) %>
  </div>
</section>
